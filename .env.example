# Stellar network the whole app targets. The course runs on testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional overrides. Leave unset to use the public testnet endpoints:
#   Horizon  https://horizon-testnet.stellar.org
#   RPC      https://soroban-testnet.stellar.org
# NEXT_PUBLIC_STELLAR_HORIZON_URL=
# NEXT_PUBLIC_STELLAR_RPC_URL=

# Switching to mainnet requires a provider-specific RPC URL — there is no public
# default. See https://developers.stellar.org/docs/data/apis/rpc/providers
